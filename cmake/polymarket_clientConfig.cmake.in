@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(CURL REQUIRED)
find_dependency(OpenSSL REQUIRED)
find_dependency(Threads REQUIRED)
find_dependency(ZLIB REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/polymarket_clientTargets.cmake")

set(POLYMARKET_CLIENT_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
set(POLYMARKET_CLIENT_LIB_DIR "${PACKAGE_PREFIX_DIR}/lib")
